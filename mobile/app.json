{
  "expo": {
    "name": "TaskMesh AI",
    "slug": "taskmesh-ai",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/taskmesh-logo.png",
    "scheme": "taskmesh",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/taskmesh-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gsc_projects.taskmesh"
    },
    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/images/*",
      "assets/sounds/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "android": {
            "image": "./assets/images/taskmesh-logo.png",
            "imageWidth": 125
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow TaskMesh AI access to store securely"
        }
      ],
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5a494fa3-be41-49f9-89bb-1d360361056b"
      }
    },
    "owner": "gsc-projects"
  }
}
